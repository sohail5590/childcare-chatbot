# .env
# This file stores configuration variables and secrets for your services.

# --- MySQL Database Configuration ---
# These variables are used by both the 'db' service to initialize itself
# and the 'backend-api' service to connect to the database.

# The name of the database to be created.
OPENAI_API_KEY=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
CHAT_BACKEND_URL=http://chat-backend:9100
MYSQL_DATABASE=moviedb
OPENAI_MODEL=gpt-4o-mini
# The non-root user for the application to use.
MYSQL_USER=user

# The password for the non-root user.
MYSQL_PASSWORD=password

# The password for the MySQL root user.
MYSQL_ROOT_PASSWORD=rootpassword

# --- Backend Service Configuration ---
# Hostnames for the services the backend needs to connect to.
# These match the service names in docker-compose.yml.
DB_HOST=db
CHROMA_HOST=chromadb
OLLAMA_HOST=ollama